<% content_for :title, "Back Office · Franjas Horarias y Turnos" %>

<div class="container">
  <!-- STATS -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon">⏱️</div>
      <div class="stat-details">
        <span class="stat-number"><%= @time_slots.count %></span>
        <span class="stat-label">Franjas Creadas</span>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon">📅</div>
      <div class="stat-details">
        <span class="stat-number"><%= @time_slots.select(:day_of_week).distinct.count %></span>
        <span class="stat-label">Días con Turnos</span>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon">⚡</div>
      <div class="stat-details">
        <span class="stat-number">60 min</span>
        <span class="stat-label">Duración Estándar</span>
      </div>
    </div>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 2rem;">
    <!-- TIME SLOTS TABLE -->
    <div class="card" style="grid-column: span 2;">
      <div class="card-header">
        <div>
          <h2 class="card-title">Franjas Horarias Configuradas</h2>
          <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.2rem;">
            Horarios habilitados para la reserva de canchas en el complejo.
          </p>
        </div>
        <div>
          <%= link_to new_admin_time_slot_path, class: "btn btn-primary btn-sm" do %>
            <span>➕</span> Nueva Franja
          <% end %>
        </div>
      </div>

      <div class="card-body" style="padding: 0;">
        <% if @time_slots.any? %>
          <div class="table-responsive" style="border: none; border-radius: 0;">
            <table class="data-table">
              <thead>
                <tr>
                  <th>ID</th>
                  <th>Día de la Semana</th>
                  <th>Hora Inicio</th>
                  <th>Hora Fin</th>
                  <th>Rango</th>
                  <th style="text-align: right;">Acciones</th>
                </tr>
              </thead>
              <tbody>
                <% @time_slots.each do |slot| %>
                  <tr>
                    <td style="font-family: var(--font-display); font-weight: 700; color: var(--text-muted);">
                      #<%= slot.id %>
                    </td>
                    <td>
                      <span style="font-weight: 700; color: var(--navy);">
                        📅 <%= slot.day_name %>
                      </span>
                    </td>
                    <td>
                      <span class="badge" style="background: var(--sky-blue-subtle); color: var(--navy); border: 1px solid var(--blue-bell);">
                        <%= slot.start_time ? slot.start_time.strftime("%H:%M") : "--" %> hs
                      </span>
                    </td>
                    <td>
                      <span class="badge" style="background: var(--sky-blue-subtle); color: var(--navy); border: 1px solid var(--blue-bell);">
                        <%= slot.end_time ? slot.end_time.strftime("%H:%M") : "--" %> hs
                      </span>
                    </td>
                    <td>
                      <strong style="color: var(--persian-blue); font-size: 0.95rem;">
                        <%= slot.formatted_time_range %>
                      </strong>
                    </td>
                    <td>
                      <div class="actions-cell" style="justify-content: flex-end;">
                        <%= button_to admin_time_slot_path(slot), method: :delete, form: { data: { turbo_confirm: "¿Estás seguro de eliminar este horario?" } }, class: "btn btn-danger btn-sm" do %>
                          <span>🗑️</span> Eliminar
                        <% end %>
                      </div>
                    </td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        <% else %>
          <div style="text-align: center; padding: 3rem 1.5rem;">
            <div style="font-size: 2.5rem; margin-bottom: 0.75rem;">⏱️</div>
            <h3 style="color: var(--navy); margin-bottom: 0.35rem;">No hay franjas horarias cargadas</h3>
            <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.25rem;">
              Agregá los turnos disponibles para que los equipos puedan reservar.
            </p>
          </div>
        <% end %>
      </div>
    </div>

    <!-- QUICK ADD FORM CARD -->
    <div>
      <div class="card">
        <div class="card-header">
          <h2 class="card-title">➕ Agregar Horario</h2>
        </div>
        <div class="card-body">
          <%= form_with(model: [:admin, @time_slot], local: true) do |f| %>
            <% if @time_slot.errors.any? %>
              <div class="form-errors" style="margin-bottom: 1rem;">
                <ul>
                  <% @time_slot.errors.full_messages.each do |msg| %>
                    <li><%= msg %></li>
                  <% end %>
                </ul>
              </div>
            <% end %>

            <div class="form-group">
              <%= f.label :day_of_week, "Día de la Semana", class: "form-label" %>
              <%= f.select :day_of_week, [["Lunes", 1], ["Martes", 2], ["Miércoles", 3], ["Jueves", 4], ["Viernes", 5], ["Sábado", 6], ["Domingo", 7]], {}, class: "form-control" %>
            </div>

            <div class="form-group">
              <%= f.label :start_time, "Hora de Inicio", class: "form-label" %>
              <%= f.time_field :start_time, class: "form-control", required: true %>
            </div>

            <div class="form-group">
              <%= f.label :end_time, "Hora de Fin", class: "form-label" %>
              <%= f.time_field :end_time, class: "form-control", required: true %>
            </div>

            <%= f.submit "Guardar Horario", class: "btn btn-primary", style: "width: 100%; margin-top: 1rem;" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</div>
