<%= form_with(model: [:admin, court], local: true) do |form| %>
  <% if court.errors.any? %>
    <div class="form-errors" role="alert">
      <h3>⚠️ <%= pluralize(court.errors.count, "error") %> impidieron guardar la cancha:</h3>
      <ul>
        <% court.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, "Nombre o Identificador de la Cancha", class: "form-label" %>
    <%= form.text_field :name, class: "form-control", placeholder: "Ej. Cancha 1 - Sintético Pro", required: true %>
    <small style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem; display: block;">
      Debe ser un nombre descriptivo y único dentro del complejo deportivo.
    </small>
  </div>

  <div class="form-group">
    <%= form.label :price, "Tarifa por Turno (en ARS $)", class: "form-label" %>
    <%= form.number_field :price, step: 0.01, min: 1, class: "form-control", placeholder: "Ej. 25000", required: true %>
    <small style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem; display: block;">
      Precio por hora de alquiler (mayor a 0).
    </small>
  </div>

  <div class="form-group">
    <label class="form-checkbox-label">
      <%= form.check_box :covered, class: "form-checkbox" %>
      <div>
        <div style="font-weight: 700;">Cancha Techada (Cubierta)</div>
        <div style="font-size: 0.8rem; color: var(--text-muted); font-weight: normal;">
          Marcá esta opción si la cancha cuenta con tinglado o domo cerrado para lluvia.
        </div>
      </div>
    </label>
  </div>

  <div class="form-group">
    <%= form.label :photo, "Foto de la Cancha (Active Storage)", class: "form-label" %>
    <% if court.photo.attached? %>
      <div style="margin-bottom: 0.75rem; display: flex; align-items: center; gap: 1rem;">
        <%= image_tag court.photo, style: "width: 100px; height: 70px; object-fit: cover; border-radius: var(--radius-md); border: 2px solid var(--blue-bell);" %>
        <span style="font-size: 0.85rem; color: var(--text-muted);">Foto actual adjunta</span>
      </div>
    <% end %>
    <%= form.file_field :photo, accept: "image/*", class: "form-control" %>
    <small style="color: var(--text-muted); font-size: 0.8rem; margin-top: 0.25rem; display: block;">
      Subí una imagen representativa del campo de juego (JPG, PNG, WebP).
    </small>
  </div>

  <div class="form-actions">
    <%= link_to "Cancelar", admin_courts_path, class: "btn btn-secondary" %>
    <%= form.submit court.new_record? ? "Guardar Cancha" : "Actualizar Cancha", class: "btn btn-primary" %>
  </div>
<% end %>
