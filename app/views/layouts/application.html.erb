<!DOCTYPE html>
<html lang="es">
  <head>
    <title><%= content_for(:title) || "Back Office · Cancha Turnos" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="Panel de administración de turnos y canchas.">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Cancha Turnos - Back Office">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- Google Fonts: Outfit & Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700;800;900&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- TOP NAVBAR BACK OFFICE -->
    <header class="site-navbar">
      <div class="navbar-container">
        <%= link_to root_path, class: "navbar-brand" do %>
          <div class="brand-icon-box">⚽</div>
          <div class="brand-text">
            <span class="brand-title">CANCHA TURNOS</span>
            <span class="brand-subtitle">Back Office</span>
          </div>
        <% end %>

        <button class="nav-toggle" id="navToggleBtn" aria-label="Abrir menú de navegación">
          ☰
        </button>

        <nav class="navbar-nav" id="mainNavLinks">
          <%= link_to admin_courts_path, class: "nav-link #{'active' if controller_name == 'courts'}" do %>
            ⚽ Canchas
          <% end %>
          <%= link_to admin_time_slots_path, class: "nav-link #{'active' if controller_name == 'time_slots'}" do %>
            ⏱️ Franjas Horarias
          <% end %>
          <%= link_to admin_reservations_path, class: "nav-link #{'active' if controller_name == 'reservations'}" do %>
            📅 Reservas
          <% end %>
          <%= link_to admin_users_path, class: "nav-link #{'active' if controller_name == 'users'}" do %>
            👥 Usuarios
          <% end %>
        </nav>
      </div>
    </header>

    <!-- BACK OFFICE HEADER & NAVIGATION TABS -->
    <div class="admin-header-bar">
      <div class="admin-header-top">
        <div>
          <div class="admin-title-badge">
            <span>🛡️</span> Panel de Control Administrativo
          </div>
          <h1 class="admin-heading">Back Office de Gestión</h1>
          <p class="admin-subheading">Administrá canchas, turnos, reservas de clientes y usuarios del complejo.</p>
        </div>
        <div class="admin-quick-actions">
          <% if controller_name == 'courts' && action_name == 'index' %>
            <%= link_to new_admin_court_path, class: "btn btn-accent btn-sm" do %>
              <span>➕</span> Nueva Cancha
            <% end %>
          <% elsif controller_name == 'time_slots' && action_name == 'index' %>
            <%= link_to new_admin_time_slot_path, class: "btn btn-accent btn-sm" do %>
              <span>➕</span> Nuevo Horario
            <% end %>
          <% end %>
        </div>
      </div>

      <div class="admin-nav-tabs">
        <%= link_to admin_courts_path, class: "admin-tab #{'active' if controller_name == 'courts'}" do %>
          <span>⚽</span> Canchas
          <span class="tab-badge"><%= Court.count %></span>
        <% end %>
        <%= link_to admin_time_slots_path, class: "admin-tab #{'active' if controller_name == 'time_slots'}" do %>
          <span>⏱️</span> Franjas Horarias
          <span class="tab-badge"><%= TimeSlot.count %></span>
        <% end %>
        <%= link_to admin_reservations_path, class: "admin-tab #{'active' if controller_name == 'reservations'}" do %>
          <span>📅</span> Reservas
          <span class="tab-badge"><%= Reservation.count %></span>
        <% end %>
        <%= link_to admin_users_path, class: "admin-tab #{'active' if controller_name == 'users'}" do %>
          <span>👥</span> Usuarios
          <span class="tab-badge"><%= User.count %></span>
        <% end %>
      </div>
    </div>

    <!-- FLASH MESSAGES -->
    <main class="main-content">
      <div class="container" style="padding-top: 1.5rem; padding-bottom: 0;">
        <% if notice %>
          <div class="flash-notice" role="alert">
            <span>✅</span> <%= notice %>
          </div>
        <% end %>
        <% if alert %>
          <div class="flash-alert" role="alert">
            <span>⚠️</span> <%= alert %>
          </div>
        <% end %>
      </div>

      <%= yield %>
    </main>

    <!-- FOOTER BACK OFFICE -->
    <footer class="site-footer">
      <div class="footer-container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div class="navbar-brand">
          <div class="brand-icon-box">⚽</div>
          <div class="brand-text">
            <span class="brand-title">CANCHA TURNOS</span>
            <span class="brand-subtitle">Panel de Control</span>
          </div>
        </div>
        <p style="color: var(--sky-blue-light); font-size: 0.85rem; margin: 0;">
          Back Office Exclusivo para Administración · TP2 Programación IV
        </p>
      </div>

      <div class="footer-bottom">
        <p>&copy; <%= Time.current.year %> Cancha Turnos. Todos los derechos reservados.</p>
      </div>
    </footer>

    <!-- Vanilla JS for Mobile Nav Toggle -->
    <script>
      document.addEventListener('DOMContentLoaded', function() {
        var toggleBtn = document.getElementById('navToggleBtn');
        var navLinks = document.getElementById('mainNavLinks');
        if (toggleBtn && navLinks) {
          toggleBtn.addEventListener('click', function() {
            navLinks.classList.toggle('show');
          });
        }
      });
    </script>
  </body>
</html>
